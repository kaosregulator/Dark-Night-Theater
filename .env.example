# ============================================================================
#  DARKNIGHT HOME THEATER — environment configuration
#  Copy this file to ".env" and fill in your own secrets.
#  On Replit/Railway, add these as "Secrets"/"Variables" instead of a file.
#  Nothing here is committed — .env is gitignored.
# ============================================================================

# ---- Discord Application ---------------------------------------------------
# Create an app at https://discord.com/developers/applications
DISCORD_BOT_TOKEN=                # Bot -> Reset Token
DISCORD_CLIENT_ID=                # OAuth2 / General -> Application ID
DISCORD_CLIENT_SECRET=            # OAuth2 -> Client Secret (needed for the Activity)
# Optional: register slash commands instantly to ONE guild while developing.
# Leave blank in production to register globally (can take up to ~1 hour).
DISCORD_DEV_GUILD_ID=

# ---- Cloudflare Stream -----------------------------------------------------
# https://dash.cloudflare.com -> Stream
CLOUDFLARE_ACCOUNT_ID=            # Stream -> right sidebar "Account ID"
CLOUDFLARE_STREAM_API_TOKEN=      # My Profile -> API Tokens -> token with Stream:Read (and Edit to sync)

# --- Signed (private) playback ---
# Two ways to protect private videos. You only need ONE.
#   A) API tokens (default, simplest): leave the two SIGNING_KEY vars blank and the
#      server will ask Cloudflare to mint a short-lived token using the API token above.
#   B) Local signing (faster, no per-play API call): create a signing key
#      (Stream -> Settings -> "Create signing key") and paste both values below.
CLOUDFLARE_STREAM_SIGNING_KEY_ID=
# Paste the PEM/JWK "pem" value. For multi-line PEM, wrap the whole thing in quotes
# and keep the literal \n, OR base64-encode it and set CLOUDFLARE_STREAM_SIGNING_KEY_B64=1.
CLOUDFLARE_STREAM_SIGNING_KEY_PEM=
CLOUDFLARE_STREAM_SIGNING_KEY_B64=0

# ---- App / hosting ---------------------------------------------------------
# The PUBLIC https url of this deployment. This is what you map in the Discord
# Developer Portal under Activities -> URL Mappings ("/" -> this host).
# Replit: https://<repl-name>.<user>.repl.co   Railway: https://<service>.up.railway.app
PUBLIC_BASE_URL=
PORT=3000

# Comma-separated Discord user IDs that may run global admin commands
# (library sync, etc.) regardless of per-server roles. Your own ID is a good idea.
ADMIN_USER_IDS=

# Random string used to sign short-lived internal session tokens. Any long value.
SESSION_SECRET=change-me-to-a-long-random-string

# How long (seconds) a Cloudflare signed playback URL stays valid. Must exceed
# your longest movie. Default 6h so 1hr+ films play through with margin.
STREAM_TOKEN_TTL_SECONDS=21600
