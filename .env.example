# ============================================================================
#  DARKNIGHT HOME THEATER — environment configuration
#  Copy this file to ".env" and fill in your own secrets.
#  On Replit/Railway, add these as "Secrets"/"Variables" instead of a file.
#  Nothing here is committed — .env is gitignored.
#
#  Movies are hosted LOCALLY (from disk, streamed with HTTP range support).
#  There is NO Cloudflare / cloud storage. To go live you basically need the
#  Discord token + client id/secret, then add movies at  <your-url>/host .
# ============================================================================

# ---- Discord Application ---------------------------------------------------
# Create an app at https://discord.com/developers/applications
DISCORD_BOT_TOKEN=                # Bot -> Reset Token
DISCORD_CLIENT_ID=                # General -> Application ID
DISCORD_CLIENT_SECRET=            # OAuth2 -> Client Secret (needed for the Activity)
# Optional: register slash commands instantly to ONE guild while developing.
DISCORD_DEV_GUILD_ID=

# ---- App / hosting ---------------------------------------------------------
# The PUBLIC https url of this deployment. Used for the Activity URL mapping
# ("/" -> this host) and for the /host upload page link.
# Replit: https://<repl-name>.<user>.repl.co   Railway: https://<svc>.up.railway.app
PUBLIC_BASE_URL=
PORT=3000

# ---- Local movie host ------------------------------------------------------
# Folder where movie files live / are uploaded to. Relative to the project root.
# Drop files in here, OR upload from your device at  <PUBLIC_BASE_URL>/host .
MEDIA_DIR=media
# Protects the /host uploader. If blank, falls back to SESSION_SECRET.
HOST_ADMIN_KEY=
# Max single upload size (MB).
MAX_UPLOAD_MB=8192
# How long a signed /media playback URL stays valid (seconds). Must exceed your
# longest movie + the length of a watch session. Default 24h.
MEDIA_TOKEN_TTL=86400
# Temporary per-party movie sessions (the "Host a Movie" flow) are auto-scrubbed
# after this age, after ~30 min idle, or when the party ends. Default 6h.
SESSION_TTL_SECONDS=21600

# Comma-separated Discord user IDs allowed to run admin commands anywhere.
ADMIN_USER_IDS=
# Random string used to sign playback tokens & the /host key fallback.
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Image Target Watcher --------------------------------------------------
# Required in production: Railway Postgres connection string.
# In Railway → Dark-Night-Theater → Variables, add a reference:
#   DATABASE_URL = ${{Postgres.DATABASE_URL}}
# Schema is auto-created on boot (image_targets / fingerprints / settings / detections / strikes).
DATABASE_URL=
# Optional SSL overrides (Railway needs TLS by default):
# PG_SSL=true
# PG_SSL=false   # local docker only
# Free Jina AI key for stage-2 visual embeddings (jina-clip-v2).
# Get one at https://jina.ai/?sui=apikey
# Without this key the watcher still works using local perceptual hashes only.
# Also enable the Message Content Intent in the Discord Developer Portal.
JINA_API_KEY=
# Optional Image Target V2 / V2.1 tuning (safe defaults — usually leave unset):
# IMAGE_TARGET_MAX_FRAMES=10
# IMAGE_TARGET_DEEP_MAX_FRAMES=18
# IMAGE_TARGET_VIDEO_SAMPLE_COUNT=8
# IMAGE_TARGET_MAX_MEDIA_PER_MESSAGE=12
# IMAGE_TARGET_MAX_VARIANTS=9
# IMAGE_TARGET_DEEP_MAX_VARIANTS=14
# IMAGE_TARGET_MAX_JINA_CALLS=6
# IMAGE_TARGET_ANALYSIS_TIMEOUT_MS=25000
# IMAGE_TARGET_DEEP_ANALYSIS_TIMEOUT_MS=35000
# IMAGE_TARGET_FFMPEG_TIMEOUT_MS=15000
# IMAGE_TARGET_CONCURRENCY=2
# IMAGE_TARGET_EMBEDDING_THRESHOLD=0.9
# IMAGE_TARGET_LOCAL_OBVIOUS=0.88
# IMAGE_TARGET_LOCAL_SKIP=0.32
# IMAGE_TARGET_LOCAL_CANDIDATE=0.52
# IMAGE_TARGET_LOCAL_MATCH=0.82
