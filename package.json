{
  "name": "darknight-home-theater",
  "version": "1.0.0",
  "description": "DarkNight Home Theater — a Discord-native social movie theater Activity that streams movies from your own device/files.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "build": "vite build",
    "register": "node src/bot/register-commands.js",
    "dev": "node --watch src/index.js",
    "dev:client": "vite",
    "postinstall": "node scripts/postinstall.js",
    "test:moviebox": "node scripts/test-large-moviebox.mjs",
    "emoji:fetch": "node scripts/fetch-emoji-offline.mjs",
    "test:conversion": "node scripts/test-conversion-first.mjs"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^1.9.0",
    "@napi-rs/canvas": "^1.0.6",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "fuse.js": "^7.1.0",
    "gifenc": "^1.0.3",
    "gifencoder": "^2.0.1",
    "gifuct-js": "^2.1.0",
    "hls.js": "^1.7.3",
    "p-queue": "^8.1.0",
    "phaser": "^4.2.1",
    "sharp": "^0.35.4",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "vite": "^5.4.11"
  },
  "overrides": {
    "canvas": "file:vendor/canvas-stub"
  }
}
